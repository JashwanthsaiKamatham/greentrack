# Copy this file to .env and fill in the values. NEVER commit .env.

PORT=4000
NODE_ENV=development

# Long random string used to sign login sessions (JWT)
JWT_SECRET=change-me-to-a-long-random-string

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed once, to create the tables (npm run setup-db). Use ONE of these:
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=

# Google Gemini (backend only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Frontend URL(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173
